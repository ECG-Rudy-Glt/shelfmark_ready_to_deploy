# Référence complète de toutes les variables (auto-générée par le projet) :
# https://github.com/calibrain/shelfmark/blob/main/docs/environment-variables.md

# ── Général ─────────────────────────────────────────────────────────────
# UID/GID du process dans le conteneur — aligne sur l'utilisateur hôte
# propriétaire de ./data pour éviter des soucis de permissions sur les
# fichiers téléchargés.
PUID=1000
PGID=1000

# Port publié sur l'hôte (le conteneur écoute toujours sur 8084 en interne).
SHELFMARK_PORT=8084

# ── Recherche ───────────────────────────────────────────────────────────
# direct    = uniquement Anna's Archive/LibGen/Z-Library/Welib, aucun indexeur
#             torrent requis — c'est le mode pour lequel ce repo est prêt à
#             l'emploi tel quel.
# universal = direct + indexeurs torrent (Prowlarr) + client de téléchargement,
#             voir la section optionnelle en bas de fichier.
SEARCH_MODE=direct
BOOK_LANGUAGE=fr

# Formats conservés dans les résultats de recherche.
SUPPORTED_FORMATS=epub,mobi,azw3,fb2,djvu,cbz,cbr

# ── Téléchargement direct — Anna's Archive & mirroirs ──────────────────
# Obligatoire : sans au moins une URL de mirroir Anna's Archive, la recherche
# directe ne renvoie aucun résultat malgré DIRECT_DOWNLOAD_ENABLED=true.
DIRECT_DOWNLOAD_ENABLED=true
AA_BASE_URL=auto
AA_MIRROR_URLS=https://annas-archive.gl,https://annas-archive.pk,https://annas-archive.gd
# Optionnel — clé de compte donateur Anna's Archive (accélère les téléchargements)
AA_DONATOR_KEY=
LIBGEN_MIRROR_URLS=
ZLIB_MIRROR_URLS=
WELIB_MIRROR_URLS=

# Les mirroirs Anna's Archive sont protégés par DDoS-Guard (pas Cloudflare) :
# le bypasser interne (Chromium headless, voir shm_size dans
# docker-compose.yml) le gère correctement. Ne PAS activer
# USING_EXTERNAL_BYPASSER/FlareSolverr pour cette source : FlareSolverr ne
# sait pas résoudre les challenges DDoS-Guard (issue upstream FlareSolverr
# #886, "closed as not planned") — testé et confirmé non fonctionnel.
USE_CF_BYPASS=true
USING_EXTERNAL_BYPASSER=false

# ── Où vont les livres téléchargés ──────────────────────────────────────
# folder (défaut) = fichiers déposés dans ./data/books.
# Autres options : email (envoi SMTP direct, ex. vers une Kindle),
# booklore (upload API vers une instance Grimmory/Calibre-Web Automated).
# Voir la doc upstream pour les variables EMAIL_*/BOOKLORE_* correspondantes
# si tu changes ce mode.
BOOKS_OUTPUT_MODE=folder

# ── Accès à l'interface web ─────────────────────────────────────────────
# none (défaut)    = pas d'authentification, ok pour un usage strictement
#                    local/LAN sur une seule machine.
# builtin          = comptes utilisateurs locaux — recommandé si l'instance
#                    est partagée ou accessible au-delà de ta seule machine.
AUTH_METHOD=none

# ── Optionnel — mode universal : indexeurs torrent + débrideur ─────────
# Décommente et renseigne uniquement si tu veux SEARCH_MODE=universal avec
# Prowlarr + un débrideur (AllDebrid/Real-Debrid) ou un client torrent
# classique (qBittorrent/Transmission/...). Nécessite ta propre instance
# Prowlarr — pas fournie par ce repo, voir README.
# PROWLARR_ENABLED=true
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# PROWLARR_TORRENT_CLIENT=alldebrid
# ALLDEBRID_API_KEY=
# REALDEBRID_API_KEY=
